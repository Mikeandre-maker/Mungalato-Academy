# Keep this value on the server. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=replace_with_your_api_key
# Choose a model available to your OpenAI API account.
OPENAI_MODEL=gpt-4.1-mini
# Basic per-IP in-memory rate limit; use Redis/Upstash for multi-instance production.
JUDGE_RATE_LIMIT_PER_HOUR=12
